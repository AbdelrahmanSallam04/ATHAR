<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.nonprofit.controller.ShellController"
            styleClass="app-shell">

    <!-- ===== Sidebar ===== -->
    <left>
        <VBox styleClass="sidebar">
            <HBox styleClass="brand" alignment="CENTER_LEFT">
                <StackPane>
                    <ImageView fx:id="logoImage" fitWidth="52" fitHeight="52" preserveRatio="true" smooth="true" visible="false" managed="false"/>
                    <Label fx:id="brandMark" text="&#x623;&#x62B;&#x631;" styleClass="brand-mark"/>
                </StackPane>
                <VBox spacing="2" alignment="CENTER_LEFT">
                    <Label text="ATHAR" styleClass="brand-title"/>
                    <Label text="Non-Profit Management &amp; Impact Platform" styleClass="brand-sub"
                           wrapText="true" maxWidth="140"/>
                </VBox>
            </HBox>

            <Region styleClass="sidebar-separator"/>
            <Label text="MAIN MENU" styleClass="sidebar-section"/>

            <fx:define>
                <ToggleGroup fx:id="navGroup"/>
            </fx:define>

            <!-- Donor menu -->
            <ToggleButton fx:id="dashboardNav" text="Dashboard" userData="dashboard" toggleGroup="$navGroup" styleClass="sidebar-item">
                <graphic><FontIcon iconLiteral="mdi2v-view-dashboard-outline" iconSize="20"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="donationsNav" text="Donations" userData="donations" toggleGroup="$navGroup" styleClass="sidebar-item">
                <graphic><FontIcon iconLiteral="mdi2h-hand-heart-outline" iconSize="20"/></graphic>
            </ToggleButton>
            <ToggleButton text="Communications" userData="communications" toggleGroup="$navGroup" styleClass="sidebar-item">
                <graphic><FontIcon iconLiteral="mdi2m-message-text-outline" iconSize="20"/></graphic>
            </ToggleButton>
            <ToggleButton text="My Profile" userData="profile" toggleGroup="$navGroup" styleClass="sidebar-item">
                <graphic><FontIcon iconLiteral="mdi2a-account-circle-outline" iconSize="20"/></graphic>
            </ToggleButton>

            <Region VBox.vgrow="ALWAYS"/>
            <Region styleClass="sidebar-separator"/>

            <!-- Populated from UserSession by ShellController -->
            <HBox styleClass="sidebar-user" alignment="CENTER_LEFT">
                <Label fx:id="avatarLabel" text="?" styleClass="avatar"/>
                <VBox>
                    <Label fx:id="sidebarUserName" text="Loading…" styleClass="sidebar-user-name"/>
                    <Label fx:id="sidebarUserRole" text="" styleClass="sidebar-user-role"/>
                </VBox>
            </HBox>
        </VBox>
    </left>

    <!-- ===== Top bar + content ===== -->
    <center>
        <VBox>
            <HBox styleClass="topbar">
                <Label fx:id="pageTitle" styleClass="page-title"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Label fx:id="topbarAvatar" text="?" styleClass="avatar"/>
            </HBox>

            <StackPane VBox.vgrow="ALWAYS">
                <ImageView fx:id="watermark" fitWidth="380" preserveRatio="true" opacity="0.06"
                           mouseTransparent="true" visible="false" managed="false"
                           StackPane.alignment="BOTTOM_RIGHT"/>
                <ScrollPane fitToWidth="true" styleClass="content-scroll">
                    <VBox fx:id="contentArea" styleClass="content-area"/>
                </ScrollPane>
            </StackPane>
        </VBox>
    </center>
</BorderPane>
